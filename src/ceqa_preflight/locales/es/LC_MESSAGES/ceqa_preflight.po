#, python-format
msgid ""
"\n"
"        %(count)s applicable check(s) did not run. This report makes no statement "
"about\n"
"        what they cover."
msgstr ""
"\n"
"        %(count)s verificación(es) aplicable(s) no se ejecutaron. Este informe no "
"hace ninguna declaración sobre\n"
"        lo que cubren."

#, python-format
