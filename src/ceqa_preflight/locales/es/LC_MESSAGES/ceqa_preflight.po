#, python-format
msgid ""
"\n"
"        Tool version %(tool_version)s, ruleset %(ruleset_version)s,\n"
"        generated %(generated_at)s."
msgstr ""
"\n"
"        Versión de la herramienta %(tool_version)s, conjunto de reglas "
"%(ruleset_version)s,\n"
"        generado %(generated_at)s."

#, python-brace-format
