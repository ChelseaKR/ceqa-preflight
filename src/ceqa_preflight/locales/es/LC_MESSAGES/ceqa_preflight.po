msgstr " — error del modelo: {error}"

#, python-brace-format
msgid " — not extracted: {reason}"
msgstr " — no extraído: {reason}"

#, python-brace-format
msgid ""
"# DRAFT manifest generated by `ceqa-preflight ai extract` ({provider}/{model}, prompt"
" {prompt_version}, {generated_at}).\n"
"# Every value below was copied from the document text and verified against a quote,\n"
"# or left at a placeholder. Review and correct it before running `check --manifest`.\n"
"# This is not a finding and not a determination of anything.\n"
msgstr ""
"# Manifiesto BORRADOR generado por `ceqa-preflight ai extract` ({provider}/{model}, "
"prompt {prompt_version}, {generated_at}).\n"
"# Cada valor a continuación se copió del texto del documento y se verificó contra una"
" cita,\n"
"# o se dejó en un marcador de posición. Revíselo y corríjalo antes de ejecutar `check"
" --manifest`.\n"
"# Esto no es un hallazgo ni una determinación de nada.\n"

#, python-format
msgid ""
"%(failure)s failure(s), %(warning)s warning(s), %(passed)s passed check(s),\n"
"        %(manual)s manual-review item(s), %(not_run)s check(s) not run."
msgstr ""
"%(failure)s error(es), %(warning)s advertencia(s), %(passed)s verificación(es) "
"aprobada(s),\n"
"        %(manual)s elemento(s) de revisión manual, %(not_run)s verificación(es) no "
"ejecutada(s)."

