msgstr "  Retenido(s): {count} afirmación(es) no superó/superaron la verificación ({reasons})."

#, python-brace-format
msgid "  [FOUND] {name}: {value}  (page {page}, quote: \"{quote}\")"
msgstr "  [ENCONTRADO] {name}: {value}  (página {page}, cita: \"{quote}\")"

