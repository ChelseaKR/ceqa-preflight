{%- macro cite(source) -%}
{%- if source -%}
<br><a href="{{ source.url }}">{{ source_labels[source.kind] }}</a>
{%- if source.kind != "official" %}<br><small class="source-kind">{{ source_notes[source.kind] }}</small>{% endif -%}
{%- endif -%}
{%- endmacro -%}
<!doctype html>
<html lang="{{ lang }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ _("CEQA Preflight advisory report") }}</title>
    <style>
      body { color: #1b1b1b; font-family: system-ui, sans-serif; line-height: 1.5; margin: 2rem auto; max-width: 70rem; padding: 0 1rem; }
      table { border-collapse: collapse; width: 100%; }
      caption { font-weight: 700; text-align: left; }
      th, td { border: 1px solid #555; padding: .65rem; text-align: left; vertical-align: top; }
      th { background: #f1f1f1; }
      .status { font-weight: 700; }
      .failure { color: #9c0006; }
      .warning, .manual { color: #7a4d00; }
      .pass { color: #146c2e; }
      .metadata { color: #444; font-size: .9rem; }
      .source-kind { color: #444; }
      @media print {
        body { margin: 0; max-width: none; }
        a { color: inherit; text-decoration: none; }
        tr { break-inside: avoid; }
      }
    </style>
  </head>
  <body>
    <header>
      <h1>{{ _("CEQA Preflight advisory report") }}</h1>
      <p><strong>{{ _("Filing type") }}:</strong> {{ report.filing_type }}</p>
      <p>{{ report.disclaimer }}</p>
      <p><strong>{{ _("Summary") }}:</strong>
        {{ _("{failure} failure(s), {warning} warning(s), {passed} passed check(s), {manual} manual-review item(s), {not_run} check(s) not run.").format(failure=counts["failure"], warning=counts["warning"], passed=counts["pass"], manual=counts["manual"], not_run=counts["not_run"]) }}</p>
      {% if report.not_run %}
      <p class="scope"><strong>{{ _("Scope") }}:</strong>
        {{ _("{count} applicable check(s) did not run. This report makes no statement about what they cover.").format(count=report.not_run | length) }}</p>
      {% else %}
      <p class="scope">{{ _("Every check that applies to this filing type ran.") }}</p>
      {% endif %}
      <p class="metadata">
        {{ _("Tool version {tool}, ruleset {ruleset}, generated {generated}.").format(tool=report.tool_version, ruleset=report.ruleset_version, generated=report.generated_at.isoformat()) }}<br>
        {{ _("Package fingerprint {value}.").format(value=report.input_fingerprint) }}
      </p>
    </header>
    <main>
      <h2>{{ _("Automated findings") }}</h2>
      {% if report.findings %}
      <table>
        <caption>{{ _("Automated technical checks") }}</caption>
        <thead><tr><th scope="col">{{ _("Status") }}</th><th scope="col">{{ _("Rule") }}</th><th scope="col">{{ _("Finding") }}</th><th scope="col">{{ _("Remediation") }}</th></tr></thead>
        <tbody>
        {% for finding in report.findings %}
          <tr>
            <td class="status {{ finding.status }}">{{ finding.status }}</td>
            <td>{{ finding.rule_id }}{{ cite(finding.source) }}</td>
            <td>{{ finding.message }}{% if finding.document %}<br><small>{{ _("Document: {value}").format(value=finding.document) }}</small>{% endif %}</td>
            <td>{{ finding.remediation }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p>{{ _("No automated findings were generated.") }}</p>
      {% endif %}
      <h2>{{ _("Manual review") }}</h2>
      {% if report.manual_review %}
      <table>
        <caption>{{ _("Items that require human review") }}</caption>
        <thead><tr><th scope="col">{{ _("Rule") }}</th><th scope="col">{{ _("Item") }}</th><th scope="col">{{ _("Remediation") }}</th></tr></thead>
        <tbody>
        {% for finding in report.manual_review %}
          <tr><td>{{ finding.rule_id }}{{ cite(finding.source) }}</td><td>{{ finding.message }}</td><td>{{ finding.remediation }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p>{{ _("No manual-review items were generated.") }}</p>
      {% endif %}
      <h2>{{ _("Checks that did not run") }}</h2>
      {% if report.not_run %}
      <table>
        <caption>{{ _("Applicable checks this report does not cover") }}</caption>
        <thead><tr><th scope="col">{{ _("Rule") }}</th><th scope="col">{{ _("Check") }}</th><th scope="col">{{ _("Why it did not run") }}</th></tr></thead>
        <tbody>
        {% for skipped in report.not_run %}
          <tr><td>{{ skipped.rule_id }}{{ cite(skipped.source) }}</td><td>{{ skipped.title }}</td><td>{{ skipped.detail }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p>{{ _("Every check that applies to this filing type ran.") }}</p>
      {% endif %}
    </main>
  </body>
</html>
