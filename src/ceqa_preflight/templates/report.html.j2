{%- macro cite(source) -%}
{%- if source -%}
<br><a href="{{ source.url }}">{{ source_labels[source.kind] }}</a>
{%- if source.kind != "official" %}<br><small class="source-kind">{{ source_notes[source.kind] }}</small>{% endif -%}
{%- endif -%}
{%- endmacro -%}
<!doctype html>
<html lang="{{ locale }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% trans %}CEQA Preflight advisory report{% endtrans %}</title>
    <style>
      body { color: #1b1b1b; font-family: system-ui, sans-serif; line-height: 1.5; margin: 2rem auto; max-width: 70rem; padding: 0 1rem; }
      table { border-collapse: collapse; width: 100%; }
      caption { font-weight: 700; text-align: left; }
      th, td { border: 1px solid #555; padding: .65rem; text-align: left; vertical-align: top; }
      th { background: #f1f1f1; }
      .status { font-weight: 700; }
      .failure { color: #9c0006; }
      .warning, .manual { color: #7a4d00; }
      .pass { color: #146c2e; }
      .metadata { color: #444; font-size: .9rem; }
      .source-kind { color: #444; }
      @media print {
        body { margin: 0; max-width: none; }
        a { color: inherit; text-decoration: none; }
        tr { break-inside: avoid; }
      }
    </style>
  </head>
  <body>
    <header>
      <h1>{% trans %}CEQA Preflight advisory report{% endtrans %}</h1>
      <p><strong>{% trans %}Filing type:{% endtrans %}</strong> {{ report.filing_type }}</p>
      <p>{{ report.disclaimer }}</p>
      <p><strong>{% trans %}Summary:{% endtrans %}</strong>
        {% trans failure=counts["failure"], warning=counts["warning"], passed=counts["pass"], manual=counts["manual"], not_run=counts["not_run"] -%}
        {{ failure }} failure(s), {{ warning }} warning(s), {{ passed }} passed check(s),
        {{ manual }} manual-review item(s), {{ not_run }} check(s) not run.
        {%- endtrans %}</p>
      {% if report.not_run %}
      <p class="scope"><strong>{% trans %}Scope:{% endtrans %}</strong>
        {%- trans count=report.not_run | length %}
        {{ count }} applicable check(s) did not run. This report makes no statement about
        what they cover.
        {%- endtrans %}</p>
      {% else %}
      <p class="scope">{% trans %}Every check that applies to this filing type ran.{% endtrans %}</p>
      {% endif %}
      <p class="metadata">
        {%- trans tool_version=report.tool_version, ruleset_version=report.ruleset_version, generated_at=report.generated_at.isoformat() %}
        Tool version {{ tool_version }}, ruleset {{ ruleset_version }},
        generated {{ generated_at }}.
        {%- endtrans %}<br>
        {%- trans fingerprint=report.input_fingerprint %}
        Package fingerprint {{ fingerprint }}.
        {%- endtrans %}
      </p>
    </header>
    <main>
      <h2>{% trans %}Automated findings{% endtrans %}</h2>
      {% if report.findings %}
      <table>
        <caption>{% trans %}Automated technical checks{% endtrans %}</caption>
        <thead><tr>
          <th scope="col">{% trans %}Status{% endtrans %}</th>
          <th scope="col">{% trans %}Rule{% endtrans %}</th>
          <th scope="col">{% trans %}Finding{% endtrans %}</th>
          <th scope="col">{% trans %}Remediation{% endtrans %}</th>
        </tr></thead>
        <tbody>
        {% for finding in report.findings %}
          <tr>
            <td class="status {{ finding.status }}">{{ finding.status }}</td>
            <td>{{ finding.rule_id }}{{ cite(finding.source) }}</td>
            <td>{{ finding.message }}{% if finding.document %}<br><small>{% trans document=finding.document %}Document: {{ document }}{% endtrans %}</small>{% endif %}</td>
            <td>{{ finding.remediation }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p>{% trans %}No automated findings were generated.{% endtrans %}</p>
      {% endif %}
      <h2>{% trans %}Manual review{% endtrans %}</h2>
      {% if report.manual_review %}
      <table>
        <caption>{% trans %}Items that require human review{% endtrans %}</caption>
        <thead><tr>
          <th scope="col">{% trans %}Rule{% endtrans %}</th>
          <th scope="col">{% trans %}Item{% endtrans %}</th>
          <th scope="col">{% trans %}Remediation{% endtrans %}</th>
        </tr></thead>
        <tbody>
        {% for finding in report.manual_review %}
          <tr><td>{{ finding.rule_id }}{{ cite(finding.source) }}</td><td>{{ finding.message }}</td><td>{{ finding.remediation }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p>{% trans %}No manual-review items were generated.{% endtrans %}</p>
      {% endif %}
      <h2>{% trans %}Checks that did not run{% endtrans %}</h2>
      {% if report.not_run %}
      <table>
        <caption>{% trans %}Applicable checks this report does not cover{% endtrans %}</caption>
        <thead><tr>
          <th scope="col">{% trans %}Rule{% endtrans %}</th>
          <th scope="col">{% trans %}Check{% endtrans %}</th>
          <th scope="col">{% trans %}Why it did not run{% endtrans %}</th>
        </tr></thead>
        <tbody>
        {% for skipped in report.not_run %}
          <tr><td>{{ skipped.rule_id }}{{ cite(skipped.source) }}</td><td>{{ skipped.title }}</td><td>{{ skipped.detail }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p>{% trans %}Every check that applies to this filing type ran.{% endtrans %}</p>
      {% endif %}
    </main>
  </body>
</html>
